# ==========================================
# JARVIS Environment Configuration Template
# Copy this file to .env and insert your API keys
# ==========================================

# Active AI Provider: "gemini", "openai", or "local"
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration
# Get your API key from OpenAI Platform (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local / Ollama Configuration (OpenAI compatible HTTP API)
LOCAL_API_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
APP_DATA_DIR=data
